NODE_ENV=production
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────
# Defaults to server/data/site.db. Rebuilt from server/seed.js on every
# boot; only enquiries are written at runtime, and they are also emailed.
# DATABASE_PATH=/data/site.db

# ─── Email for new enquiries (required — this is how you receive them) ─
# Check them with: npm run mail:test -- you@example.com
# Render's free plan blocks ports 25, 465 and 587; use a provider that
# accepts port 2525 there (e.g. Brevo: smtp-relay.brevo.com:2525).
# For Gmail (paid hosting / local only), use an App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="HNXT Logistics <no-reply@hnxtlogistics.com>"
# Enquiries are sent from this address, named after the customer. Must be on
# the authenticated domain and must not be the inbox itself (defaults to
# website@<SMTP_FROM domain>).
# ENQUIRY_FROM=website@hnxtlogistics.com
ENQUIRY_INBOX=info@hnxtlogistics.com
