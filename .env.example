# ─── Required in production ───────────────────────────────────────────
# Signs admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

NODE_ENV=production
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────
# Defaults to server/data/site.db. On a host with a mounted volume,
# point this at the persistent path so content survives redeploys.
# DATABASE_PATH=/data/site.db

# ─── First-run admin account (only used when no user exists yet) ──────
ADMIN_EMAIL=hnxtlogistics@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Site Administrator

# ─── Optional: email notifications for new enquiries ──────────────────
# Enquiries are always saved to the database. These only add an email
# copy on top. For Gmail, use an App Password, not the account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="HNXT Logistics <no-reply@hnxtlogistics.com>"
# ENQUIRY_INBOX=hnxtlogistics@gmail.com
